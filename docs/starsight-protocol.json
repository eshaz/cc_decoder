     "at": "1-2",
     "field": "length"
    },
    {
     "at": "3-4",
     "field": "an id"
    },
    {
     "at": "5",
     "field": "a byte"
    },
    {
     "at": "6",
     "field": "flags"
    },
    {
     "at": "7",
     "field": "low 3 bits: first length; upper bits: more flags"
    },
    {
     "at": "8",
     "field": "second length"
    },
    {
     "at": "9",
     "field": "third length"
    },
    {
     "at": "10-11",
     "field": "a 16 bit value"
    },
    {
     "at": "12..",
     "field": "the three payloads, one after another"
    }
   ]
  },
  {
   "name": "type 39",
   "type": 39,
   "bytes": [
    {
     "at": "0",
     "field": "type"
    },
    {
     "at": "1-2",
     "field": "length"
    },
    {
     "at": "3-4",
     "field": "an id"
    },
    {
     "at": "5-6",
     "field": "a 16 bit value"
    },
    {
     "at": "7-10",
     "field": "a 32 bit value"
    },
    {
     "at": "11",
     "field": "a byte"
    }
   ]
  },
  {
   "name": "type 40",
   "type": 40,
   "bytes": [
    {
     "at": "0",
     "field": "type"
    },
    {
     "at": "1-2",
     "field": "length"
    },
    {
     "at": "3-4",
     "field": "an id"
    },
    {
     "at": "5",
     "field": "a byte"
    },
    {
     "at": "6..",
     "field": "payload, to the length in bytes 1-2"
    }
   ]
  },
  {
   "name": "type 42",
   "type": 42,
   "bytes": [
    {
     "at": "0",
     "field": "type"
    },
    {
     "at": "1-2",
     "field": "length"
    },
    {
     "at": "8",
     "field": "bits 4-5: 0 stops a receiver acting on Region, Channel Data, Show List, the theme commands and types 36 and 37; 1 lets it act on them again; 2 and 3 do nothing"
    },
    {
     "at": "3-25",
     "field": "otherwise unexplained"
    }
   ]
  }
 ],
