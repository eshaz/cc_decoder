 "commandLayouts": [
  {
   "name": "Time",
   "type": 1,
   "bytes": [
    {
     "at": "0",
     "field": "type"
    },
    {
     "at": "1",
     "field": "length"
    },
    {
     "at": "2-5",
     "field": "the time, to the minute"
    },
    {
     "at": "6",
     "field": "zone and daylight saving flags"
    },
    {
     "at": "7",
     "field": "seconds"
    }
   ]
  },
  {
   "name": "Daylight Saving Change",
   "type": 2,
   "bytes": [
    {
     "at": "0",
     "field": "type"
    },
    {
     "at": "1",
     "field": "length"
    },
    {
     "at": "2-5",
     "field": "daylight saving starts"
    },
    {
     "at": "6-9",
     "field": "daylight saving ends"
    }
   ]
  },
  {
   "name": "Region",
   "type": 3,
   "bytes": [
    {
     "at": "0",
     "field": "type"
    },
    {
     "at": "1-2",
     "field": "length"
    },
    {
     "at": "3-4",
     "field": "region id"
    },
    {
     "at": "5",
     "field": "flags"
    },
    {
     "at": "6-9",
     "field": "the time the lineup takes effect"
    },
    {
     "at": "10",
     "field": "channel count, so a lineup holds at most 255"
    },
    {
     "at": "11.. +0",
     "field": "bit 7: channel number bit 8; bits 0-6: channel id high 7"
    },
    {
     "at": "11.. +1",
     "field": "channel id low 8 (15 bits with the byte before)"
    },
    {
     "at": "11.. +2",
     "field": "channel number low 8 (9 bits with the byte before): the number the channel sits on in this region"
    },
    {
     "at": "11.. +3",
     "field": "the tier, and two bits of unknown meaning"
    }
   ]
  },
  {
   "name": "Channel Data",
   "type": 4,
   "bytes": [
    {
     "at": "0",
     "field": "type"
    },
    {
     "at": "1",
     "field": "length, 16"
    },
    {
     "at": "2",
     "field": "unknown"
    },
    {
     "at": "3",
     "field": "bit 7: channel number bit 8; bits 0-6: channel id high 7"
    },
    {
     "at": "4",
     "field": "channel id low 8 (15 bits with byte 3)"
    },
    {
     "at": "5",
     "field": "flags"
    },
    {
     "at": "6",
     "field": "channel number low 8 (9 bits with byte 3): the channel a station broadcasts on, zero for a cable service"
    },
    {
     "at": "7",
     "field": "which of bytes 8-15 make the short label"
    },
    {
     "at": "8-15",
     "field": "a station's CALL-NET - call letters, a dash, the network - or a cable service's name, which can carry a dash of its own: SCI-FI, CNN-HLN, DSC-KIDS"
    }
   ]
  },
  {
   "name": "Show List",
   "type": 5,
   "bytes": [
    {
     "at": "0",
     "field": "type and the encryption bits; an encrypted list keeps bytes 0-10 in the clear"
    },
    {
     "at": "1-2",
     "field": "length"
    },
    {
     "at": "3",
     "field": "low nibble: a version. A receiver skips a list for a channel and day it already holds at it, and a revised day comes with a higher one"
    },
    {
     "at": "4-5",
     "field": "channel id, 15 bits (0x7FFF)"
    },
    {
     "at": "6-9",
     "field": "start of the first slot, a GMT midnight"
    },
    {
     "at": "10",
     "field": "slot count"
    },
    {
     "at": "11..",
     "field": "slots: flags, minutes, show id, then the optional fields"
    }
   ]
  },
  {
   "name": "Show Title",
   "type": 6,
   "bytes": [
    {
     "at": "0",
     "field": "type"
    },
    {
     "at": "1",
     "field": "length"
    },
    {
     "at": "2",
     "field": "flags"
    },
    {
     "at": "3-4",
     "field": "show id"
    },
    {
     "at": "5-6",
     "field": "theme id"
    },
    {
     "at": "7..",
     "field": "title"
    }
   ]
  },
  {
   "name": "Show Description",
   "type": 8,
   "bytes": [
    {
     "at": "0",
     "field": "type"
    },
    {
     "at": "1",
     "field": "length"
    },
    {
     "at": "2",
     "field": "flags"
    },
    {
     "at": "3-4",
     "field": "description id"
    },
    {
     "at": "7",
     "field": "critic's stars (bits 7-5), film rating code (bits 4-1), extended form only. The codes are 0 NR, 1 G, 2 NC-17, 3 PG, 4 PG-13, 5 R, 6 NC-17, 7 NC-17"
    },
    {
     "at": "8",
     "field": "content advisories, extended form only"
    },
    {
     "at": "9",
     "field": "year, last two digits, zero for none; extended form only"
    },
    {
     "at": "7.. or 10..",
     "field": "text, after the extended bytes when present"
    }
   ]
  },
  {
   "name": "Region Name",
   "type": 9,
   "bytes": [
    {
     "at": "0",
     "field": "type"
    },
    {
     "at": "1",
     "field": "length"
    },
    {
     "at": "2-3",
     "field": "region id"
    },
    {
     "at": "4..",
     "field": "the name, always compressed: 'columbus, oh', 'akron - time warner cable'"
    }
   ]
  },
  {
   "name": "Cycle Start",
   "type": 10,
   "bytes": [
    {
     "at": "0",
     "field": "type"
    },
    {
     "at": "1",
     "field": "length, 9"
    },
    {
     "at": "2-8",
     "field": "unexplained. The command marks the start of a carousel cycle; a receiver scanning for the guide counts them"
    }
   ]
  },
  {
   "name": "Theme Category",
   "type": 11,
   "bytes": [
    {
     "at": "0",
     "field": "type"
    },
    {
     "at": "1-2",
     "field": "length"
    },
    {
     "at": "3",
     "field": "version; a change means every name is to be reloaded"
    },
    {
     "at": "4",
     "field": "entry count"
    },
    {
     "at": "5..",
     "field": "entries of: id, flags, length, then a NUL terminated name: 1 Movies to 11 Miscellaneous. The flag byte's meaning is unknown"
    }
   ]
  },
  {
   "name": "Theme Sub-Category",
   "type": 12,
   "bytes": [
    {
     "at": "0",
     "field": "type"
    },
    {
     "at": "1-2",
     "field": "length"
    },
    {
     "at": "3",
     "field": "the Theme Category id these belong to"
    },
    {
     "at": "4",
     "field": "entry count, low 7 bits"
    },
    {
     "at": "5..",
     "field": "entries of: their own length, flags, a count of theme ids, the ids, then the name. They are the receiver's search menus: each category opens with an 'All' list and closes with a 'Closed Captioned' one, and one theme sits in as many as fit it. The flag byte's meaning is unknown"
    }
   ]
  },
  {
   "name": "Subscriber Reset",
   "type": 13,
   "bytes": [
    {
     "at": "0",
     "field": "type"
    },
    {
     "at": "1",
     "field": "length"
    },
    {
     "at": "2",
     "field": "what to discard"
    },
    {
     "at": "3-7",
     "field": "the receiver it is for; zero for every receiver"
    }
   ]
  },
  {
   "name": "Authorization",
   "type": 14,
   "bytes": [
    {
     "at": "0",
     "field": "type"
    },
    {
     "at": "1",
     "field": "length"
    },
    {
     "at": "2-5",
     "field": "the receiver it is for"
    },
    {
     "at": "6..",
     "field": "opaque"
    }
   ]
  },
  {
   "name": "Key Distribution",
   "type": 17,
   "bytes": [
    {
     "at": "0",
     "field": "type"
    },
    {
     "at": "1",
     "field": "length"
    },
    {
     "at": "2-5",
     "field": "the receiver it is for; sent in rising order"
    },
    {
     "at": "6..",
     "field": "opaque"
    }
   ]
  },
  {
   "name": "Sequence Number",
   "type": 20,
   "bytes": [
    {
     "at": "0",
     "field": "type"
    },
    {
     "at": "1",
     "field": "length"
    },
    {
     "at": "2-5",
     "field": "a 32 bit counter, one per packet"
    }
   ]
  },
  {
   "name": "Station Node Status",
   "type": 21,
   "bytes": [
    {
     "at": "0",
     "field": "type"
    },
    {
     "at": "1-2",
     "field": "length: growing in layout 1; 721 to 743 bytes in layouts 3 and 4"
    },
    {
     "at": "3",
     "field": "layout: 1, 3 or 4. Layout 1 places its fields after byte 20 differently"
    },
    {
     "at": "4-5",
     "field": "in layouts 3 and 4, a software release: 200, 403 and 405 are known"
    },
    {
     "at": "6-7",
     "field": "the stream id the packet headers carry"
    },
    {
     "at": "8-11",
     "field": "a Unix time, constant over a session"
    },
    {
     "at": "12-15",
     "field": "when the block's contents were assembled, Unix seconds; unset in layout 4"
    },
    {
     "at": "20-23",
     "field": "a Unix time, or 0x12CEA600 - 1980-01-01, the zero of a DOS clock - where nothing set it, as every unset time in the block is"
    },
    {
     "at": "58 (layout 1), 48 (layout 3), 48 (layout 4)",
     "field": "the station clock when the block was sent, Unix seconds"
    },
    {
     "at": "38-39, 50-51, 40-41 (layout 1)",
     "field": "how far through its cycle the station is: a total, how many are done and how many remain, the last two adding up to the first"
    },
    {
     "at": "66-67 (layout 1)",
     "field": "minutes since the assembly time. The block grows by two bytes for every eight"
    },
    {
     "at": "the rest of layout 1",
     "field": "zero"
    },
    {
     "at": "56-57 (layouts 3 and 4)",
     "field": "how many bits of each minute map are in use, 1433 to 1440: it gains one a minute, and when it would pass 1440 both maps turn a byte to the left and it drops by eight, so the bit before it is the current minute"
    },
    {
     "at": "58-237, 238-417",
     "field": "two maps of the last day, a bit a minute, the first bit the most significant. What a set bit means is unknown"
    },
    {
     "at": "420-429 (layout 4)",
     "field": "an unset time and six zero bytes, which layout 4 inserts, so everything after them sits 10 bytes later than in layout 3"
    },
    {
     "at": "432-459",
     "field": "the station's inventory of its own guide: how many it holds of each of 14 tables - regions, channels, titles, descriptions, then the schedules of 10 days from the GMT day of its clock, each counting channels"
    },
    {
     "at": "460-461",
     "field": "the stream id again"
    },
    {
     "at": "462",
     "field": "the number of tables, 14"
    },
    {
     "at": "463-714",
     "field": "a 18 byte record a table of what the station lacks: a count, then the lowest eight missing ids, ascending, zero where there are fewer"
    },
    {
     "at": "721-724",
     "field": "from software 403 on, a time at the same local time every day, always the latest one before the clock"
    },
    {
     "at": "the rest of layouts 3 and 4",
     "field": "unknown: times at 20-27 and 420-431, a running counter at 30-33, constants at 28-29 and 38-39, values at 40-47, and short counts at 715-732"
    }
   ]
  },
  {
   "name": "Postal Code",
   "type": 31,
   "bytes": [
    {
     "at": "0",
     "field": "type"
    },
    {
     "at": "1-2",
     "field": "length"
    },
    {
     "at": "3-8",
     "field": "the postal code as text; codes are sent in sort order"
    },
    {
     "at": "9",
     "field": "unknown"
    },
    {
     "at": "10",
     "field": "antenna region count"
    },
    {
     "at": "11",
     "field": "cable region count"
    },
    {
     "at": "12..",
     "field": "that many two byte region ids, then the cable ones"
    },
    {
     "at": "then",
     "field": "the news area its pages are filed under, then a byte of unknown meaning"
    }
   ]
  },
  {
   "name": "News Service",
   "type": 32,
   "bytes": [
    {
     "at": "0",
     "field": "type"
    },
    {
     "at": "1-2",
     "field": "length"
    },
    {
     "at": "3-6",
     "field": "unknown"
    },
    {
     "at": "7",
     "field": "name length"
    },
    {
     "at": "8..",
     "field": "the name, usually in the clear: 'StarSight NEWS Services'"
    }
   ]
  },
  {
   "name": "News Menu",
   "type": 33,
   "bytes": [
    {
     "at": "0",
     "field": "type"
    },
    {
     "at": "1-2",
     "field": "length"
    },
    {
     "at": "3",
     "field": "unknown"
    },
    {
     "at": "4",
     "field": "section count"
    },
    {
     "at": "5..",
     "field": "sections of: number, five unknown bytes, name length, the name compressed"
    }
   ]
  },
  {
   "name": "News Page",
   "type": 34,
   "bytes": [
    {
     "at": "0",
     "field": "type"
    },
    {
     "at": "1-2",
     "field": "length"
    },
    {
     "at": "3",
     "field": "the menu section it is under"
    },
    {
     "at": "4",
     "field": "unknown"
    },
    {
     "at": "5-6",
     "field": "page number"
    },
    {
     "at": "7",
     "field": "flags"
    },
    {
     "at": "8-9",
     "field": "unknown"
    },
    {
     "at": "10",
     "field": "the news area of the postal codes it is for; zero for every area"
    },
    {
     "at": "11-14",
     "field": "when it was written"
    },
    {
     "at": "15",
     "field": "unknown"
    },
    {
     "at": "16",
     "field": "title length"
    },
    {
     "at": "17..",
     "field": "the title, compressed"
    },
    {
     "at": "then",
     "field": "text length, sixteen bits; 0x8000 set when the text is in the clear"
    },
    {
     "at": "then",
     "field": "the text: compressed, it breaks lines with the 0x1F phrase, 'ur' everywhere else; in the clear, with CR. `i, `a and `d set text apart up to `e or the end of the line"
    }
   ]
  },
  {
   "name": "Segmented Command",
   "type": 36,
   "bytes": [
    {
     "at": "0",
     "field": "type"
    },
    {
     "at": "1-2",
     "field": "length"
    },
    {
     "at": "3",
     "field": "high nibble: this part; low nibble: the last part"
    },
    {
     "at": "4",
     "field": "which message the parts belong to"
    },
    {
     "at": "5..",
     "field": "that part of a command. Joined in order, the parts end with a CRC-32 over the whole, at most 3000 bytes"
    }
   ]
  },
  {
   "name": "type 37",
   "type": 37,
   "bytes": [
    {
     "at": "0",
     "field": "type"
    },
    {
     "at": "1-2",
     "field": "length"
    },
    {
     "at": "3",
     "field": "low nibble: a version; a day already held at it is skipped"
    },
    {
     "at": "4-5",
     "field": "region count"
    },
    {
     "at": "6..",
     "field": "that many region ids: the regions it is for"
    },
    {
     "at": "after them",
     "field": "a midnight, one of the next seven"
    },
    {
     "at": "then",
     "field": "an entry count, and that many entries of a byte and a 16 bit value"
    }
   ]
  },
  {
   "name": "type 38",
