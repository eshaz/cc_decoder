{
 "packet": [
  {
   "offset": 0,
   "bytes": 1,
   "field": "sync",
   "note": "Always 0x2C."
  },
  {
   "offset": 1,
   "bytes": 2,
   "field": "size",
   "note": "The whole packet in bytes, this header and the trailer included, MSB first. At most 0x7F8."
  },
  {
   "offset": 3,
   "bytes": 4,
   "field": "time",
   "note": "The minute the packet was sent: minutes since 1992-01-01 GMT, MSB first."
  },
  {
   "offset": 7,
   "bytes": 2,
   "field": "stream",
   "note": "Stream id, naming the feed."
  },
  {
   "offset": 9,
   "bytes": 2,
   "field": "header check",
   "note": "The low 16 bits of the CRC of bytes 0-8, least significant byte first."
  },
  {
   "offset": 11,
   "bytes": null,
   "field": "commands",
   "note": "Concatenated commands, which fill it exactly."
  },
  {
   "offset": null,
   "bytes": 4,
   "field": "body check",
   "note": "The CRC of everything before it, least significant byte first, so that the CRC of the whole packet is zero."
  }
 ],
 "checksums": [
  {
   "property": "algorithm",
   "value": "Table driven reflected CRC-32"
  },
  {
   "property": "polynomial",
   "value": "0xEDB88320, the standard IEEE one"
  },
  {
   "property": "initial value",
   "value": "0xFFFFFFFF"
  },
  {
   "property": "final inversion",
   "value": "none - the register is returned as it stands"
  },
  {
   "property": "header check",
   "value": "crc(bytes 0..8) & 0xFFFF == bytes 9-10 read little endian"
  },
  {
   "property": "body check",
   "value": "crc(the whole packet, its own trailer included) == 0"
  }
 ],
